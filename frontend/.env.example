# TerraLedger frontend → backend API base URL.
# Points at the FastAPI backend (backend/app/main.py), which mounts routes under /api.
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: explicit WebSocket base for live telemetry (P1).
# If unset, it is derived from VITE_API_URL (http→ws, https→wss, minus the /api suffix).
# VITE_API_WS_URL=ws://127.0.0.1:8000

# ── "Wow feature" layer (P1–P5) — all additive, all default true.
#    Set any to "false" to disable that feature; the original app keeps working.
VITE_ENABLE_LIVE_TWIN=true
VITE_ENABLE_DUAL_AI=true
VITE_ENABLE_CERTIFICATES=true
VITE_ENABLE_SATELLITE=true
VITE_ENABLE_FLEET=true
VITE_ENABLE_WHATIF=true

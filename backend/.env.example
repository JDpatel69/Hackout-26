# App
APP_NAME=Algae Carbon MRV API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./mrv.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Model toggles — both trained models now load in-process.
AI_IMAGE_MODEL_ENABLED=true
AI_SENSOR_MODEL_ENABLED=true

# Fallback directories (used only if the absolute *_FILE paths below are blank).
AI_IMAGE_MODEL_PATH=./models/algae_image_model
AI_SENSOR_MODEL_PATH=./models/sensor_verify_model

# Optional remote inference endpoints (if models run as separate services).
# When set, the remote adapter is used instead of the in-process one.
AI_IMAGE_MODEL_URL=
AI_SENSOR_MODEL_URL=

# Absolute paths to the trained model artifacts (loaded in-process).
#   image  → ONNX segmentation export (run via onnxruntime)
#   sensor → joblib-saved XGBoost biomass regressor
AI_IMAGE_MODEL_FILE=C:\Users\you\Desktop\Models\algae_segmentation.onnx
AI_SENSOR_MODEL_FILE=C:\Users\you\Desktop\Sensor_Node\Outputs\xgboost_biomass_model.pkl

# Image preprocessing knobs (the ONNX file does not carry these).
# Override with the exact training values from inspect_checkpoint.py if available.
AI_IMAGE_TILE_SIZE=512
AI_IMAGE_NORM_MEAN=0.485,0.456,0.406
AI_IMAGE_NORM_STD=0.229,0.224,0.225
AI_IMAGE_THRESHOLD=0.5

# ── "Wow feature" layer (P1–P5) — all additive, all default true.
#    Set any to false to disable that feature; the original app keeps working.
ENABLE_LIVE_TELEMETRY=true
ENABLE_DUAL_AI_PANEL=true
ENABLE_CERTIFICATES=true
ENABLE_SATELLITE=true
ENABLE_IMPACT_PUBLIC=true
ENABLE_FLEET=true
ENABLE_WHATIF=true
# Synthesize gradual simulated readings (labeled dataSource="simulation") when
# a farm has no recent live device data. Set false for live-only telemetry.
LIVE_DEMO_MODE=true
# Frontend origin embedded in issued certificates (QR + public /verify link).
PUBLIC_APP_URL=http://localhost:5173

# App
APP_NAME=Algae Carbon MRV API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./mrv.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Model toggles — set to true when trained models are ready
AI_IMAGE_MODEL_ENABLED=false
AI_SENSOR_MODEL_ENABLED=false

# Paths to load real models later (ignored while ENABLED=false)
AI_IMAGE_MODEL_PATH=./models/algae_image_model
AI_SENSOR_MODEL_PATH=./models/sensor_verify_model

# Optional remote inference endpoints (if models run as separate services)
AI_IMAGE_MODEL_URL=
AI_SENSOR_MODEL_URL=
